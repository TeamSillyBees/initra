# 默认文本文件统一 LF
* text=auto eol=lf

# Go / 配置 / 脚本 / 文档
*.go      text eol=lf
*.mod     text eol=lf
*.sum     text eol=lf
*.sql     text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.json    text eol=lf
*.toml    text eol=lf
*.md      text eol=lf
*.sh      text eol=lf

# Windows 脚本可以保留 CRLF
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

# 二进制文件不要处理换行
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.zip     binary
*.exe     binary
*.dll     binary