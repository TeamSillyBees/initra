package worker

import (
	"context"
	"encoding/json"
	"errors"
	"testing"

	"github.com/teamsillybees/initra/pkg/task"
	"go.uber.org/zap"
)

// TestConfigFromEnv 验证 worker 模板能从环境变量读取任务队列连接参数。
func TestConfigFromEnv(t *testing.T) {
	t.Setenv("INITRA_TASK_REDIS_ADDR", "127.0.0.1:6380")
	t.Setenv("INITRA_TASK_REDIS_DB", "4")
	t.Setenv("INITRA_TASK_WORKER_CONCURRENCY", "2")

	cfg := configFromEnv()

	if cfg.Redis.Addr != "127.0.0.1:6380" {
		t.Fatalf("redis addr = %s", cfg.Redis.Addr)
	}
	if cfg.Redis.DB != 4 {
		t.Fatalf("redis db = %d", cfg.Redis.DB)
	}
	if cfg.Worker.Concurrency != 2 {
		t.Fatalf("worker concurrency = %d", cfg.Worker.Concurrency)
	}
}

// TestHandleSendEmail 验证示例任务处理器能解析 payload。
func TestHandleSendEmail(t *testing.T) {
	err := handleSendEmail(context.Background(), task.Task{
		Type: "demo:send_email",
		Payload: sendEmailPayload{
			UserID: "1001",
			Email:  "alice@example.com",
		},
		Meta: task.TaskMeta{BizKey: "demo:1001:send_email"},
	}, zap.NewNop())

	if err != nil {
		t.Fatalf("handleSendEmail() error = %v", err)
	}
}

// TestHandleSendEmailSkipRetryOnBadPayload 验证非法 payload 会映射为跳过重试。
func TestHandleSendEmailSkipRetryOnBadPayload(t *testing.T) {
	err := handleSendEmail(context.Background(), task.Task{
		Type:    "demo:send_email",
		Payload: json.RawMessage(`{`),
	}, zap.NewNop())

	if !errors.Is(err, task.ErrSkipRetry) {
		t.Fatalf("handleSendEmail() error = %v", err)
	}
}
