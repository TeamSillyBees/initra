package main

import (
	"context"
	"log"
	"os/signal"
	"syscall"

	"{{ .ModulePath }}/internal/worker"
)

// main 是 worker 进程入口，后续可在 internal/worker 中接入消费端和任务调度。
func main() {
	ctx, stop := signal.NotifyContext(context.Background(), syscall.SIGINT, syscall.SIGTERM)
	defer stop()

	if err := worker.Run(ctx); err != nil {
		log.Fatalf("run worker failed: %v", err)
	}
}
