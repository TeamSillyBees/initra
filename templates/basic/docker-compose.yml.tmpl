services:
  postgres:
    image: postgres:16
    container_name: {{ .AppName }}-postgres
    environment:
      POSTGRES_DB: initra
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
    ports:
      - "5432:5432"
    volumes:
      - ./tmp/postgres_data:/var/lib/postgresql/data

  redis:
    image: redis:7
    container_name: {{ .AppName }}-redis
    ports:
      - "6379:6379"
    volumes:
      - ./tmp/redis_data:/data
